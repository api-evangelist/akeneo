              }
            ]
          },
          "docs": "Update a catalog"
        },
        {
          "info": {
            "name": "Delete a catalog",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{tenant}.cloud.akeneo.com/api/rest/v1/catalogs/:id",
